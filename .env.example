# Copia questo file in .env e compila i valori (il file .env non va mai pubblicato)

# Appwrite (Settings del progetto → API Endpoint)
APPWRITE_ENDPOINT=https://<regione>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<id-progetto>
APPWRITE_API_KEY=<chiave-api>

# Per Supabase/PostgreSQL (alternativa):
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
